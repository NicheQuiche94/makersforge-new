# Required at runtime for enquiry form notifications.
RESEND_API_KEY=

# Supabase — used for enquiry persistence (Phase 3+) and job-alert signups.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — service-role key used server-side to write job-alert signups to
# the `job_alerts` table (see README "Managing the job board"). If unset, the
# alert route falls back to the anon key, and if that can't write, signups
# still reach Andre by email so no lead is lost.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — used in admin-link URLs inside transactional emails.
# Defaults to https://makersforge.gg if unset.
NEXT_PUBLIC_APP_URL=

# Optional — Apollo.io API key for the job-board contact finder
# (scripts/apollo-contacts.mjs). Finds the growth/marketing decision-maker per
# company; those get imported to Folk as leads. Email reveals spend credits.
APOLLO_API_KEY=
